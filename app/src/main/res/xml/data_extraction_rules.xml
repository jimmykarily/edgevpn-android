<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer copy an app's data to a new phone even with allowBackup="false". The
     settings file cannot be decrypted there, so it stays out of both kinds of copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
