#!/usr/bin/env bash
#
# The real-network check: the debug app on an emulator joins the test
# peer's network (scripts/testpeer), traffic flows both ways, and after the
# VPN has been off for longer than the peer's 60 second ownership TTL it
# flows again once the VPN is back on.
#
# make network-test builds the APKs and runs this. It expects the emulator
# named by ANDROID_SERIAL to be booted. It starts the test peer when it is
# not running and stops it again at the end; a peer that was already up is
# left up. The peer's temporary key goes into the app through the app's own
# storage and is never printed; the app's data is cleared at the end so the
# key does not stay on the device.
#
# NETWORK_TEST_LONG=0 skips the off/on part for a quick local run.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

SERIAL="${ANDROID_SERIAL:-emulator-5556}"
ADB="${EDGEVPN_ADB:-$ROOT/binaries/android-sdk/platform-tools/adb}"
PACKAGE="com.kairos.edgevpn"
APK="app/build/outputs/apk/debug/app-debug.apk"
TEST_APK="app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"
RUNNER="$PACKAGE.test/androidx.test.runner.AndroidJUnitRunner"

APP_ADDRESS="10.1.0.4"
PEER_ADDRESS="10.1.0.10"
# The VM's hostname, which is how the app names it.
PEER_NAME="testpeer"

CONNECT_TIMEOUT="${NETWORK_TEST_CONNECT_TIMEOUT:-300}"
RECOVER_TIMEOUT="${NETWORK_TEST_RECOVER_TIMEOUT:-300}"
# Longer than the peer's 60 second ownership TTL plus its 30 second scrub
# interval, so the peer has dropped the app's entry when the VPN comes back.
OFF_SECONDS="${NETWORK_TEST_OFF_SECONDS:-100}"
LONG="${NETWORK_TEST_LONG:-1}"
OUT="${NETWORK_TEST_OUT:-$ROOT/build/network-test}"

TESTPEER="$ROOT/scripts/testpeer"
EMULATOR="$ROOT/scripts/emulator"
STARTED_PEER=0
T0=$(date +%s)

log() { echo "[network-test +$(($(date +%s) - T0))s] $*"; }

fail() {
    log "FAIL: $*"
    save_screen "$*"
    exit 1
}

# Writes the current screen (UI dump with editable text redacted, and a
# screenshot) to $OUT, named after the failing check, so a failure on a
# machine nobody can look at can still be seen afterwards.
save_screen() {
    local name
    name=$(echo "$1" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)
    mkdir -p "$OUT" 2>/dev/null || return 0
    ui >"$OUT/fail-$name-ui.xml" 2>/dev/null || true
    adb_ exec-out screencap -p >"$OUT/fail-$name.png" 2>/dev/null || true
    echo "[network-test] saved fail-$name-ui.xml and fail-$name.png in $OUT" >&2
}

adb_() { "$ADB" -s "$SERIAL" "$@"; }

# The screen as text, with editable fields redacted (scripts/emulator ui).
# The last dump is kept in $OUT/last-ui.xml for dismiss_dialogs.
ui() {
    local dump
    dump=$(EDGEVPN_AVD_PORT="${SERIAL#emulator-}" EDGEVPN_ADB="$ADB" "$EMULATOR" ui) || return 1
    mkdir -p "$OUT" 2>/dev/null && printf '%s\n' "$dump" >"$OUT/last-ui.xml" 2>/dev/null
    printf '%s\n' "$dump"
}

# Prints "x y", the centre of the first view whose text or description is
# exactly $1, or nothing when there is none on screen.
find_view() {
    ui | python3 -I -c '
import re, sys
want = sys.argv[1]
# A label with a help sheet ends in a space and an icon character.
def label(v):
    return (v or "").replace("\ufffc", "").strip()
for node in re.findall(r"<node [^>]*>", sys.stdin.read()):
    attrs = dict(re.findall(r"([\w-]+)=\"([^\"]*)\"", node))
    if want.lower() in (label(attrs.get("text")).lower(), label(attrs.get("content-desc")).lower()):
        x1, y1, x2, y2 = map(int, re.findall(r"\d+", attrs["bounds"]))
        print((x1 + x2) // 2, (y1 + y2) // 2)
        break
' "$1"
}

on_screen() { [ -n "$(find_view "$1")" ]; }

tap() {
    local xy
    xy=$(find_view "$1")
    [ -n "$xy" ] || fail "no \"$1\" on screen"
    # shellcheck disable=SC2086
    adb_ shell input tap $xy
}

# Swipes the screen up until $1 is on screen, at most 8 times, so a row below
# the fold of a small screen is reached. Fails when it never shows.
scroll_to() {
    local i
    for i in 1 2 3 4 5 6 7 8; do
        on_screen "$1" && return 0
        adb_ shell input swipe 160 500 160 200 300
        sleep 1
    done
    on_screen "$1" || fail "no \"$1\" on screen after scrolling"
}

# Swipes the screen down to the top.
scroll_top() {
    local i
    for i in 1 2 3 4 5 6; do
        adb_ shell input swipe 160 200 160 500 200
    done
    sleep 1
}

# Closes system dialogs over the app and handles what the last dump shows: an
# "isn't responding" dialog gets its Wait button tapped, and the app's main
# activity is started again when no view of the app is on screen.
dismiss_dialogs() {
    local xy
    adb_ shell am broadcast --receiver-include-background -a android.intent.action.CLOSE_SYSTEM_DIALOGS >/dev/null 2>&1 || true
    [ -s "$OUT/last-ui.xml" ] || return 0
    xy=$(python3 -I -c '
import re, sys
xml = open(sys.argv[1], errors="replace").read()
nodes = [dict(re.findall(r"([\w-]+)=\"([^\"]*)\"", n)) for n in re.findall(r"<node [^>]*>", xml)]
if any("isn\u2019t responding" in n.get("text", "").lower() or "isn'"'"'t responding" in n.get("text", "").lower() for n in nodes):
    for n in nodes:
        if n.get("text", "").strip().lower() == "wait":
            x1, y1, x2, y2 = map(int, re.findall(r"\d+", n["bounds"]))
            print((x1 + x2) // 2, (y1 + y2) // 2)
            break
elif not any(n.get("package") == sys.argv[2] for n in nodes):
    print("start")
' "$OUT/last-ui.xml" "$PACKAGE")
    case "$xy" in
        "") ;;
        start) adb_ shell am start -n "$PACKAGE/.MainActivity" >/dev/null 2>&1 || true ;;
        # shellcheck disable=SC2086
        *) adb_ shell input tap $xy ;;
    esac
}

# Waits up to $2 seconds for $1 on screen and prints how long it took.
wait_for() {
    local text="$1" timeout="$2" start
    start=$(date +%s)
    until on_screen "$text"; do
        [ $(($(date +%s) - start)) -lt "$timeout" ] || return 1
        dismiss_dialogs
        sleep 3
    done
    echo $(($(date +%s) - start))
}

shot() {
    adb_ exec-out screencap -p >"$OUT/$1.png"
    log "screenshot $OUT/$1.png"
}

# Pings $2 from the emulator (side "app") or from the VM (side "peer")
# until one round of 3 pings gets answers, for up to $3 seconds.
ping_until() {
    local side="$1" addr="$2" timeout="$3" start out
    start=$(date +%s)
    while :; do
        if [ "$side" = app ]; then
            out=$(adb_ shell ping -c 3 -W 2 "$addr" 2>&1 || true)
        else
            out=$("$TESTPEER" ping "$addr" 2>&1 || true)
        fi
        if echo "$out" | grep -Eq ' [1-3] received'; then
            log "ping from $side to $addr after $(($(date +%s) - start))s: $(echo "$out" | grep -E 'received|rtt')"
            return 0
        fi
        [ $(($(date +%s) - start)) -lt "$timeout" ] || {
            log "ping from $side to $addr: $out"
            return 1
        }
        sleep 3
    done
}

# The app's listening TCP sockets, over IPv4 and IPv6. A count that grows
# after the VPN was turned off and on means a libp2p host from the earlier
# session is still alive.
listen_sockets() {
    local uid
    # One line per package whose name contains $PACKAGE, as
    # "package:<name> uid:<uid>"; the test APK's name contains it too.
    uid=$(adb_ shell cmd package list packages -U "$PACKAGE" | tr -d '\r' |
        sed -n "s/^package:$PACKAGE uid:\([0-9]*\)\$/\1/p")
    [ -n "$uid" ] || return 1
    adb_ shell cat /proc/net/tcp /proc/net/tcp6 | awk -v uid="$uid" '$4 == "0A" && $8 == uid' | wc -l
}

# Writes dumpsys connectivity to $OUT/connectivity.txt and prints the routes
# of the VPN network of the app, one per line, e.g. "10.1.0.0/24 -> tun0". An IPv6
# default route that is "unreachable" means Android blocks IPv6 for every app
# while the VPN is on.
vpn_routes() {
    adb_ shell dumpsys connectivity | tr -d '\r' >"$OUT/connectivity.txt"
    python3 -I -c '
import re, sys
for line in open(sys.argv[1], errors="replace"):
    if "NetworkAgentInfo" in line and "extra: VPN:" + sys.argv[2] + "}" in line:
        m = re.search(r"Routes: \[([^\]]*)\]", line)
        if m:
            print("\n".join(r.strip() for r in m.group(1).split(",")))
' "$OUT/connectivity.txt" "$PACKAGE"
}

# Exits 0 when the peer lists the app, 1 when it does not, and fails the
# test when the peer cannot be asked, so an SSH or API error never reads as
# "not listed".
peer_has_app() {
    local machines
    machines=$("$TESTPEER" machines) || fail "could not read the peer's machine list"
    echo "$machines" | grep -q "^$APP_ADDRESS "
}

# Copies stdin to stdout with the run's key replaced (scripts/testpeer
# scrub), and prints nothing when it cannot.
scrub() { "$TESTPEER" scrub; }

# Copies the app's log and the VM's edgevpn and console logs into $OUT,
# with the key replaced wherever it shows up, so the files are safe to
# upload. Runs before the peer is stopped, which deletes the console log.
collect_logs() {
    mkdir -p "$OUT"
    adb_ logcat -d -v time 2>/dev/null | scrub >"$OUT/logcat.txt" || true
    "$TESTPEER" logs >"$OUT/testpeer-edgevpn.log" 2>/dev/null || true
    "$TESTPEER" serial >"$OUT/testpeer-serial.log" 2>/dev/null || true
}

finish() {
    local status=$?
    trap - EXIT
    set +e
    collect_logs
    adb_ shell am force-stop "$PACKAGE" >/dev/null 2>&1
    # Removes the stored key and settings from the device.
    adb_ shell pm clear "$PACKAGE" >/dev/null 2>&1
    if [ "$STARTED_PEER" = 1 ]; then
        "$TESTPEER" down
    fi
    if [ "$status" -eq 0 ]; then
        log "PASS"
    else
        log "last lines of the VM's console log:"
        tail -n 40 "$OUT/testpeer-serial.log" 2>/dev/null
        log "logs in $OUT"
    fi
    exit "$status"
}

# Screenshots of the peer's device sheet and of the Logs screen, then back
# to the main screen.
screens() {
    scroll_to "$PEER_NAME"
    tap "$PEER_NAME"
    wait_for "$PEER_ADDRESS" 10 >/dev/null || fail "the device sheet for $PEER_NAME did not open"
    sleep 1
    shot device-sheet
    adb_ shell input keyevent KEYCODE_BACK
    scroll_top
    wait_for "Turn off" 10 >/dev/null || fail "the main screen did not come back"
    tap "More options"
    wait_for "Logs" 10 >/dev/null || fail "the menu did not open"
    tap "Logs"
    sleep 2
    shot logs
    adb_ shell input keyevent KEYCODE_BACK
    wait_for "Turn off" 10 >/dev/null || fail "the main screen did not come back"
}

main() {
    rm -rf "$OUT"
    mkdir -p "$OUT"
    [ -f "$APK" ] && [ -f "$TEST_APK" ] || fail "no APKs. Run: make network-test"
    [ "$(adb_ shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] || fail "$SERIAL is not booted"

    trap finish EXIT
    if ! "$TESTPEER" status >/dev/null 2>&1; then
        STARTED_PEER=1
        "$TESTPEER" up
    fi
    local peer
    peer=$("$TESTPEER" addr)
    log "peer at $peer"

    adb_ install -r "$APK" >/dev/null
    adb_ install -r "$TEST_APK" >/dev/null
    adb_ shell am force-stop "$PACKAGE"
    adb_ shell pm clear "$PACKAGE" >/dev/null
    adb_ logcat -c

    # The files go straight from the key file into the app's private
    # storage, so the key never appears on a command line.
    adb_ shell run-as "$PACKAGE" mkdir -p files/network-test
    adb_ exec-in run-as "$PACKAGE" sh -c 'cat > files/network-test/token' <"$("$TESTPEER" key)"
    echo "$peer" | adb_ exec-in run-as "$PACKAGE" sh -c 'cat > files/network-test/peers'
    local result
    result=$(adb_ shell am instrument -w -e class com.kairos.edgevpn.NetworkTestSetup "$RUNNER" | scrub) ||
        fail "could not run or scrub the setup step"
    if ! echo "$result" | grep -q "^OK (1 test)"; then
        # Only the lines that say what failed, never the whole output.
        echo "$result" | grep -E "^(FAILURES|There was|[0-9]+\)|Tests run|[a-zA-Z.]*(Error|Exception))" | head -n 20
        fail "storing the test network in the app"
    fi
    log "test network stored in the app"

    # Android asks once whether the app may run a VPN. The answer is set
    # here instead, as the dialog would.
    adb_ shell appops set "$PACKAGE" ACTIVATE_VPN allow

    dismiss_dialogs
    adb_ shell am start -W -n "$PACKAGE/.MainActivity" >/dev/null
    wait_for "Turn on" 30 >/dev/null || fail "the main screen did not show Turn on"
    tap "Turn on"
    log "turned on"
    local took
    took=$(wait_for "Connected" "$CONNECT_TIMEOUT") || { shot not-connected; fail "not connected after ${CONNECT_TIMEOUT}s"; }
    log "connected after ${took}s"
    shot connected

    local routes
    routes=$(vpn_routes)
    log "VPN routes: $(echo "$routes" | paste -sd' ')"
    [ -n "$routes" ] || fail "no VPN network with routes in dumpsys connectivity"
    if echo "$routes" | grep -Eq '^(::/0|0::/0).*unreachable'; then
        fail "the VPN blocks IPv6 for every app: route $(echo "$routes" | grep unreachable | head -n 1)"
    fi

    ping_until app "$PEER_ADDRESS" 60 || fail "the app cannot ping the peer"
    ping_until peer "$APP_ADDRESS" 60 || fail "the peer cannot ping the app"
    local sockets
    sockets=$(listen_sockets) || fail "could not find the app's uid"
    log "app LISTEN sockets: $sockets"
    [ "$sockets" -gt 0 ] || fail "the app has no listening sockets"
    peer_has_app || fail "the peer does not list $APP_ADDRESS while connected"
    log "the peer lists $APP_ADDRESS"
    screens

    if [ "$LONG" != 0 ]; then
        tap "Turn off"
        wait_for "VPN is off" 30 >/dev/null || fail "the VPN did not turn off"
        log "turned off, waiting ${OFF_SECONDS}s"
        sleep "$OFF_SECONDS"
        if peer_has_app; then
            fail "the peer still lists $APP_ADDRESS after ${OFF_SECONDS}s off"
        fi
        log "the peer has dropped $APP_ADDRESS from its machine list"
        tap "Turn on"
        log "turned on again"
        took=$(wait_for "Connected" "$RECOVER_TIMEOUT") || { shot not-reconnected; fail "not connected again after ${RECOVER_TIMEOUT}s"; }
        log "connected again after ${took}s"
        ping_until app "$PEER_ADDRESS" "$RECOVER_TIMEOUT" || fail "the app cannot ping the peer after off and on"
        ping_until peer "$APP_ADDRESS" "$RECOVER_TIMEOUT" || fail "the peer cannot ping the app after off and on"
        local after
        after=$(listen_sockets) || fail "could not find the app's uid"
        log "app LISTEN sockets after off and on: $after (before: $sockets)"
        [ "$after" -eq "$sockets" ] || fail "the app has $after listening sockets after off and on, want $sockets as before"
    fi

    shot connected-final
    "$TESTPEER" machines | sed 's/^/[peer machines] /'
}

main "$@"
