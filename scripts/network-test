#!/usr/bin/env bash
#
# The real-network check: the debug app on an emulator joins the test
# peer's network (scripts/testpeer), traffic flows both ways, and after the
# VPN has been off for longer than the peer's 60 second ownership TTL it
# flows again once the VPN is back on.
#
# make network-test builds the APKs and runs this. It expects the emulator
# named by ANDROID_SERIAL to be booted. It starts the test peer when it is
# not running and stops it again at the end; a peer that was already up is
# left up. The peer's temporary key goes into the app through the app's own
# storage and is never printed; the app's data is cleared at the end so the
# key does not stay on the device.
#
# NETWORK_TEST_LONG=0 skips the off/on part for a quick local run.
# NETWORK_TEST_SWITCH=0 skips the part that switches the emulator's network
# (Wi-Fi off, Wi-Fi on, airplane mode); NETWORK_TEST_SWITCH_TIMEOUT is the
# number of seconds each step has to get pings working both ways again.
# NETWORK_TEST_MDNS_CHECK=0 skips the mDNS checks: no fresh
# "mdns(android): using interfaces:" line while Wi-Fi is off, and a fresh one
# listing wlan0 after Wi-Fi is back.
#
# NETWORK_TEST_SCENARIO=address-in-use runs another check instead: the peer
# moves to the app's address before the app turns on, and the app must warn
# that another device already uses its address. The peer gets its usual
# address back at the end.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

SERIAL="${ANDROID_SERIAL:-emulator-5556}"
ADB="${EDGEVPN_ADB:-$ROOT/binaries/android-sdk/platform-tools/adb}"
PACKAGE="com.kairos.edgevpn"
APK="app/build/outputs/apk/debug/app-debug.apk"
TEST_APK="app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"
RUNNER="$PACKAGE.test/androidx.test.runner.AndroidJUnitRunner"

APP_ADDRESS="10.1.0.4"
PEER_ADDRESS="10.1.0.10"
# The VM's hostname, which is how the app names it.
PEER_NAME="testpeer"

CONNECT_TIMEOUT="${NETWORK_TEST_CONNECT_TIMEOUT:-300}"
RECOVER_TIMEOUT="${NETWORK_TEST_RECOVER_TIMEOUT:-300}"
# Longer than the peer's 60 second ownership TTL plus its 30 second scrub
# interval, so the peer has dropped the app's entry when the VPN comes back.
OFF_SECONDS="${NETWORK_TEST_OFF_SECONDS:-100}"
LONG="${NETWORK_TEST_LONG:-1}"
SWITCH="${NETWORK_TEST_SWITCH:-1}"
SWITCH_TIMEOUT="${NETWORK_TEST_SWITCH_TIMEOUT:-60}"
MDNS_CHECK="${NETWORK_TEST_MDNS_CHECK:-1}"
SCENARIO="${NETWORK_TEST_SCENARIO:-basic}"
case "$SCENARIO" in
    basic) OUT="${NETWORK_TEST_OUT:-$ROOT/build/network-test}" ;;
    address-in-use) OUT="${NETWORK_TEST_OUT:-$ROOT/build/network-test/address-in-use}" ;;
    *) echo "unknown NETWORK_TEST_SCENARIO: $SCENARIO" >&2; exit 2 ;;
esac

TESTPEER="$ROOT/scripts/testpeer"
EMULATOR="$ROOT/scripts/emulator"
STARTED_PEER=0
# 1 once this run has restarted adbd as root; finish puts it back.
ROOTED=0
MOVED_PEER=0
T0=$(date +%s)

log() { echo "[network-test +$(($(date +%s) - T0))s] $*"; }

fail() {
    log "FAIL: $*"
    save_screen "$*"
    exit 1
}

# Writes the current screen (UI dump with editable text redacted, and a
# screenshot) to $OUT, named after the failing check, so a failure on a
# machine nobody can look at can still be seen afterwards.
save_screen() {
    local name
    name=$(echo "$1" | tr -c 'A-Za-z0-9\n' '-' | cut -c1-60)
    mkdir -p "$OUT" 2>/dev/null || return 0
    ui >"$OUT/fail-$name-ui.xml" 2>/dev/null || true
    adb_ exec-out screencap -p >"$OUT/fail-$name.png" 2>/dev/null || true
    echo "[network-test] saved fail-$name-ui.xml and fail-$name.png in $OUT" >&2
}

adb_() { "$ADB" -s "$SERIAL" "$@"; }

# The screen as text, with editable fields redacted (scripts/emulator ui).
# The last dump is kept in $OUT/last-ui.xml for dismiss_dialogs.
ui() {
    local dump
    dump=$(EDGEVPN_AVD_PORT="${SERIAL#emulator-}" EDGEVPN_ADB="$ADB" "$EMULATOR" ui) || return 1
    mkdir -p "$OUT" 2>/dev/null && printf '%s\n' "$dump" >"$OUT/last-ui.xml" 2>/dev/null
    printf '%s\n' "$dump"
}

# Prints "x y", the centre of the first view whose text or description is
# exactly $1, or nothing when there is none on screen.
find_view() {
    ui | python3 -I -c '
import re, sys
want = sys.argv[1]
# A label with a help sheet ends in a space and an icon character.
def label(v):
    return (v or "").replace("\ufffc", "").strip()
for node in re.findall(r"<node [^>]*>", sys.stdin.read()):
    attrs = dict(re.findall(r"([\w-]+)=\"([^\"]*)\"", node))
    if want.lower() in (label(attrs.get("text")).lower(), label(attrs.get("content-desc")).lower()):
        x1, y1, x2, y2 = map(int, re.findall(r"\d+", attrs["bounds"]))
        print((x1 + x2) // 2, (y1 + y2) // 2)
        break
' "$1"
}

on_screen() { [ -n "$(find_view "$1")" ]; }

tap() {
    local xy
    xy=$(find_view "$1")
    [ -n "$xy" ] || fail "no \"$1\" on screen"
    # shellcheck disable=SC2086
    adb_ shell input tap $xy
}

# Swipes the screen up until $1 is on screen, at most 8 times, so a row below
# the fold of a small screen is reached. Fails when it never shows.
scroll_to() {
    local i
    for i in 1 2 3 4 5 6 7 8; do
        on_screen "$1" && return 0
        adb_ shell input swipe 160 500 160 200 300
        sleep 1
    done
    on_screen "$1" || fail "no \"$1\" on screen after scrolling"
}

# Swipes the screen down to the top.
scroll_top() {
    local i
    for i in 1 2 3 4 5 6; do
        adb_ shell input swipe 160 200 160 500 200
    done
    sleep 1
}

# Closes system dialogs over the app and handles what the last dump shows: an
# "isn't responding" dialog gets its Wait button tapped, and the app's main
# activity is started again when no view of the app is on screen.
dismiss_dialogs() {
    local xy
    adb_ shell am broadcast --receiver-include-background -a android.intent.action.CLOSE_SYSTEM_DIALOGS >/dev/null 2>&1 || true
    [ -s "$OUT/last-ui.xml" ] || return 0
    xy=$(python3 -I -c '
import re, sys
xml = open(sys.argv[1], errors="replace").read()
nodes = [dict(re.findall(r"([\w-]+)=\"([^\"]*)\"", n)) for n in re.findall(r"<node [^>]*>", xml)]
if any("isn\u2019t responding" in n.get("text", "").lower() or "isn'"'"'t responding" in n.get("text", "").lower() for n in nodes):
    for n in nodes:
        if n.get("text", "").strip().lower() == "wait":
            x1, y1, x2, y2 = map(int, re.findall(r"\d+", n["bounds"]))
            print((x1 + x2) // 2, (y1 + y2) // 2)
            break
elif not any(n.get("package") == sys.argv[2] for n in nodes):
    print("start")
' "$OUT/last-ui.xml" "$PACKAGE")
    case "$xy" in
        "") ;;
        start) adb_ shell am start -n "$PACKAGE/.MainActivity" >/dev/null 2>&1 || true ;;
        # shellcheck disable=SC2086
        *) adb_ shell input tap $xy ;;
    esac
}

# Waits up to $2 seconds for $1 on screen and prints how long it took.
wait_for() {
    local text="$1" timeout="$2" start
    start=$(date +%s)
    until on_screen "$text"; do
        [ $(($(date +%s) - start)) -lt "$timeout" ] || return 1
        dismiss_dialogs
        sleep 3
    done
    echo $(($(date +%s) - start))
}

shot() {
    adb_ exec-out screencap -p >"$OUT/$1.png"
    log "screenshot $OUT/$1.png"
}

# Pings $2 from the emulator (side "app") or from the VM (side "peer")
# until one round of 3 pings gets answers, for up to $3 seconds.
ping_until() {
    local side="$1" addr="$2" timeout="$3" start out
    start=$(date +%s)
    while :; do
        if [ "$side" = app ]; then
            out=$(adb_ shell ping -c 3 -W 2 "$addr" 2>&1 || true)
        else
            out=$("$TESTPEER" ping "$addr" 2>&1 || true)
        fi
        if echo "$out" | grep -Eq ' [1-3] received'; then
            log "ping from $side to $addr after $(($(date +%s) - start))s: $(echo "$out" | grep -E 'received|rtt')"
            return 0
        fi
        [ $(($(date +%s) - start)) -lt "$timeout" ] || {
            log "ping from $side to $addr: $out"
            return 1
        }
        sleep 3
    done
}

# The app's listening TCP sockets, over IPv4 and IPv6. A count that grows
# after the VPN was turned off and on means a libp2p host from the earlier
# session is still alive.
listen_sockets() {
    local uid
    # One line per package whose name contains $PACKAGE, as
    # "package:<name> uid:<uid>"; the test APK's name contains it too.
    uid=$(adb_ shell cmd package list packages -U "$PACKAGE" | tr -d '\r' |
        sed -n "s/^package:$PACKAGE uid:\([0-9]*\)\$/\1/p")
    [ -n "$uid" ] || return 1
    adb_ shell cat /proc/net/tcp /proc/net/tcp6 | awk -v uid="$uid" '$4 == "0A" && $8 == uid' | wc -l
}

# Writes dumpsys connectivity (scrubbed of the key) to $OUT/connectivity.txt
# and prints the routes of the app's VPN network, one per line, e.g.
# "10.1.0.0/24 -> 0.0.0.0 tun0 mtu 0".
vpn_routes() {
    adb_ shell dumpsys connectivity | tr -d '\r' | scrub >"$OUT/connectivity.txt"
    python3 -I "$ROOT/scripts/vpn-routes" "$OUT/connectivity.txt" "$PACKAGE" "$APP_ADDRESS"
}

# Fails when the VPN network has an unreachable IPv6 default route, which
# makes Android block IPv6 for every app while the VPN is on. The VPN carries
# only 10.1.0.0/24, so IPv6 is allowed to bypass it (EdgeVpnService). With
# Android's "Always-on VPN, block connections without VPN" IPv6 may now
# bypass the VPN too; that is acceptable here and untested.
check_vpn_routes() {
    local routes
    routes=$(vpn_routes)
    [ -n "$routes" ] || fail "no VPN network with routes in dumpsys connectivity; the dumpsys format may have changed, see $OUT/connectivity.txt"
    log "VPN routes: $(echo "$routes" | paste -sd' ')"
    if echo "$routes" | grep -Eq '^(::/0|0::/0).*unreachable'; then
        fail "the VPN blocks IPv6 for every app: route $(echo "$routes" | grep unreachable | head -n 1)"
    fi
}

# Exits 0 when the peer lists the app, 1 when it does not, and fails the
# test when the peer cannot be asked, so an SSH or API error never reads as
# "not listed".
peer_has_app() {
    local machines
    machines=$("$TESTPEER" machines) || fail "could not read the peer's machine list"
    echo "$machines" | grep -q "^$APP_ADDRESS "
}

# Copies stdin to stdout with the run's key replaced (scripts/testpeer
# scrub), and prints nothing when it cannot.
scrub() { "$TESTPEER" scrub; }

# Copies the app's log and the VM's edgevpn and console logs into $OUT,
# with the key replaced wherever it shows up, so the files are safe to
# upload. Runs before the peer is stopped, which deletes the console log.
collect_logs() {
    mkdir -p "$OUT"
    adb_ logcat -d -v time 2>/dev/null | scrub >"$OUT/logcat.txt" || true
    "$TESTPEER" logs >"$OUT/testpeer-edgevpn.log" 2>/dev/null || true
    "$TESTPEER" serial >"$OUT/testpeer-serial.log" 2>/dev/null || true
}

# Every socket the app opens is protected from the VPN through
# VpnService.protect. The service logs a warning when that returns false.
no_protect_failures() {
    local bad
    bad=$(adb_ logcat -d -b main -v time -s EdgeVpnService:W 2>/dev/null | { grep -F "VpnService.protect(" || true; } | head -n 5)
    if [ -n "$bad" ]; then
        echo "$bad" >&2
        fail "VpnService.protect failed during the run"
    fi
    log "no VpnService.protect failures in the app's log so far"
}

# Clears the emulator's log, trying up to 5 times. On Android 8 logcat -c
# sometimes answers "failed to clear the 'main' log" right after an install,
# and a second try a moment later works.
clear_log() {
    local i
    for i in 1 2 3 4 5; do
        adb_ logcat -c && return 0
        sleep 1
    done
    return 1
}

# Number of "mdns(android): using interfaces:" log lines.
mdns_lines() {
    adb_ logcat -d -b main 2>/dev/null | grep -cF 'mdns(android): using interfaces:' || true
}

# Number of "mdns(android): using interfaces:" log lines that list wlan0.
mdns_wlan0_lines() {
    adb_ logcat -d -b main 2>/dev/null | grep -F 'mdns(android): using interfaces:' | grep -c 'wlan0' || true
}

# Runs the network change in $2 (a command string run with eval), then
# measures the seconds until the app and the peer can ping each other, and
# fails when that takes longer than SWITCH_TIMEOUT. $1 names the step in the
# log. The action may set start again to time only the part after it.
switch_step() {
    local name="$1" action="$2" start now left
    log "switch $name: starting"
    start=$(date +%s)
    eval "$action"
    ping_until app "$PEER_ADDRESS" "$SWITCH_TIMEOUT" || fail "switch $name: the app cannot ping the peer within ${SWITCH_TIMEOUT}s"
    now=$(date +%s)
    left=$((SWITCH_TIMEOUT - (now - start)))
    [ "$left" -ge 1 ] || left=1
    ping_until peer "$APP_ADDRESS" "$left" || fail "switch $name: the peer cannot ping the app within ${SWITCH_TIMEOUT}s"
    now=$(($(date +%s) - start))
    log "switch $name: ${now}s"
    [ "$now" -le "$SWITCH_TIMEOUT" ] || fail "switch $name: ${now}s is above ${SWITCH_TIMEOUT}s"
}

# Waits until wlan0 has (state "up") or has lost (state "down") its IPv4
# address, so a ping right after svc wifi does not pass on the old network.
# Gives up after $2 seconds (default 30) and returns 1. A CI emulator can
# take well over 30 seconds to join Wi-Fi again, so the steps that wait for
# Wi-Fi to come back allow 120 and start their clock once it is up.
wait_wlan0() {
    local want="$1" deadline=$(($(date +%s) + ${2:-30}))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if adb_ shell ip -4 -o addr show wlan0 2>/dev/null | grep -q ' inet '; then
            [ "$want" = up ] && return 0
        else
            [ "$want" = down ] && return 0
        fi
        sleep 1
    done
    return 1
}

# The device's API level, such as 26 or 35.
sdk_level() {
    adb_ shell getprop ro.build.version.sdk | tr -d '\r'
}

# True when the device has "cmd connectivity airplane-mode", which Android 9
# added: asked for the state, it answers "enabled" or "disabled". Older
# versions answer "No shell command implementation."
has_airplane_cmd() {
    case "$(adb_ shell cmd connectivity airplane-mode 2>/dev/null | tr -d '\r')" in
        enabled | disabled) return 0 ;;
        *) return 1 ;;
    esac
}

# Restarts adbd as root unless it is already, and waits up to 30 seconds
# for it to answer as root, setting ROOTED when it restarted adbd. The
# default emulator images allow this; Google Play images do not.
adb_as_root() {
    local i
    [ "$(adb_ shell id -u 2>/dev/null | tr -d '\r')" = 0 ] && return 0
    adb_ root >/dev/null 2>&1 || return 1
    ROOTED=1
    for i in $(seq 30); do
        sleep 1
        [ "$(adb_ shell id -u 2>/dev/null | tr -d '\r')" = 0 ] && return 0
    done
    return 1
}

# Turns airplane mode on ($1 "enable") or off ("disable"). Without
# "cmd connectivity airplane-mode" the setting is written and the
# AIRPLANE_MODE broadcast sent, which needs adbd running as root
# (see adb_as_root, done before the switch steps).
airplane_mode() {
    if has_airplane_cmd; then
        adb_ shell cmd connectivity airplane-mode "$1"
        return
    fi
    local on=0 state=false
    if [ "$1" = enable ]; then
        on=1
        state=true
    fi
    adb_ shell settings put global airplane_mode_on "$on" &&
        adb_ shell am broadcast -a android.intent.action.AIRPLANE_MODE --ez state "$state" >/dev/null
}

# Puts Wi-Fi on and airplane mode off, whatever state a step left them in.
restore_network() {
    airplane_mode disable >/dev/null 2>&1
    adb_ shell svc wifi enable >/dev/null 2>&1
}

# The basic scenario has one device per address, so the warning that
# another device uses the app's address must never be on screen. A rejected
# deletion of the app's old entry after off and on once showed it.
no_address_warning() {
    if on_screen "Another device already uses $APP_ADDRESS. Pick another address in Settings."; then
        shot address-warning
        fail "the app warns that another device uses $APP_ADDRESS, but only the peer at $PEER_ADDRESS is in the network"
    fi
    log "no address warning on screen"
}

finish() {
    local status=$?
    trap - EXIT
    set +e
    restore_network
    collect_logs
    adb_ shell am force-stop "$PACKAGE" >/dev/null 2>&1
    # Removes the stored key and settings from the device.
    adb_ shell pm clear "$PACKAGE" >/dev/null 2>&1
    if [ "$ROOTED" = 1 ]; then
        adb_ unroot >/dev/null 2>&1
    fi
    if [ "$STARTED_PEER" = 1 ]; then
        "$TESTPEER" down
    elif [ "$MOVED_PEER" = 1 ]; then
        "$TESTPEER" readdress "$PEER_ADDRESS"
    fi
    if [ "$status" -eq 0 ]; then
        log "PASS"
    else
        log "last lines of the VM's console log:"
        tail -n 40 "$OUT/testpeer-serial.log" 2>/dev/null
        log "logs in $OUT"
    fi
    exit "$status"
}

# Screenshots of the peer's device sheet and of the Logs screen, then back
# to the main screen.
screens() {
    scroll_to "$PEER_NAME"
    tap "$PEER_NAME"
    wait_for "$PEER_ADDRESS" 10 >/dev/null || fail "the device sheet for $PEER_NAME did not open"
    sleep 1
    shot device-sheet
    adb_ shell input keyevent KEYCODE_BACK
    scroll_top
    wait_for "Turn off" 10 >/dev/null || fail "the main screen did not come back"
    tap "More options"
    wait_for "Logs" 10 >/dev/null || fail "the menu did not open"
    tap "Logs"
    sleep 2
    shot logs
    adb_ shell input keyevent KEYCODE_BACK
    wait_for "Turn off" 10 >/dev/null || fail "the main screen did not come back"
}

# True when the emulator has an IPv4 address on its virtual Wi-Fi or
# Ethernet and a default route through the emulator's gateway (10.0.2.2),
# which is also where the test peer's port is forwarded. Images before
# Android 11 put Wi-Fi and mobile data behind a router of their own, with
# gateways such as 192.168.232.1 that still reach 10.0.2.2, so there any
# IPv4 default route on wlan0 or eth0 will do.
network_ready() {
    local gateway='10\.0\.2\.2 '
    [ "$(sdk_level)" -ge 30 ] || gateway='[0-9.]+ dev (wlan0|eth0) '
    adb_ shell ip -4 -o addr show 2>/dev/null | grep -qE ' (wlan0|eth0) +inet ' &&
        adb_ shell ip route show table all 2>/dev/null | grep -qE "^default via $gateway"
}

# A CI emulator once booted with no network at all, and the test then spent
# five minutes failing to connect. Waiting here makes that fail early and
# with the cause. Turning Wi-Fi off and on once is a cheap attempt to bring
# the network back first; whether it helps in that case is unknown.
wait_for_network() {
    local waited=0
    while ! network_ready; do
        if [ "$waited" -eq 60 ]; then
            log "the emulator has no network after 60s; turning Wi-Fi off and on"
            adb_ shell svc wifi disable || true
            sleep 2
            adb_ shell svc wifi enable || true
        fi
        if [ "$waited" -ge 120 ]; then
            adb_ shell ip -4 -o addr show >"$OUT/ip-addr.txt" 2>&1 || true
            adb_ shell ip route show table all >"$OUT/ip-route.txt" 2>&1 || true
            fail "the emulator has no network (no address on wlan0 or eth0, or no default route via 10.0.2.2) after ${waited}s; see ip-addr.txt and ip-route.txt"
        fi
        sleep 2
        waited=$((waited + 2))
    done
    log "emulator network ready"
}

# The switch steps need the emulator on Wi-Fi. The local AVD has the
# emulator's own "AndroidWifi" network saved, but the CI device has no saved
# Wi-Fi network and comes up on mobile data only, so Wi-Fi off and on would
# change nothing. This joins AndroidWifi when wlan0 has no address. On
# Android 10 and older `cmd wifi connect-network` does not exist, and those
# emulators are expected to have the network saved.
ensure_wifi() {
    wait_wlan0 up 5 && return 0
    log "wlan0 has no address; joining the emulator's AndroidWifi network"
    adb_ shell svc wifi enable || true
    if [ "$(sdk_level)" -ge 30 ]; then
        adb_ shell cmd wifi connect-network AndroidWifi open >/dev/null 2>&1 || true
    fi
    wait_wlan0 up 120 || fail "the emulator has no Wi-Fi: wlan0 got no address within 120s of joining AndroidWifi"
    log "joined AndroidWifi"
}

# The address-in-use scenario. The peer takes the app's address first, so
# its entry in the shared machine list is the one every device keeps, and
# the app, turned on afterwards, must say that another device uses it.
address_in_use() {
    local peer_id="${1##*/}" warning="Another device already uses $APP_ADDRESS. Pick another address in Settings." took i
    MOVED_PEER=1
    "$TESTPEER" readdress "$APP_ADDRESS"
    for i in $(seq 1 30); do
        "$TESTPEER" machines | grep -q "^$APP_ADDRESS $peer_id\$" && break
        [ "$i" -lt 30 ] || fail "the peer does not list itself at $APP_ADDRESS after 60s"
        sleep 2
    done
    log "the peer holds $APP_ADDRESS"

    dismiss_dialogs
    adb_ shell am start -W -n "$PACKAGE/.MainActivity" >/dev/null
    wait_for "Turn on" 30 >/dev/null || fail "the main screen did not show Turn on"
    tap "Turn on"
    log "turned on"
    took=$(wait_for "$warning" "$CONNECT_TIMEOUT") || { shot no-warning; fail "no address warning after ${CONNECT_TIMEOUT}s"; }
    log "the app warns that $APP_ADDRESS is in use after ${took}s"
    on_screen "Looking for your devices" || fail "the app does not say it is looking for devices"
    no_protect_failures
    shot address-in-use

    tap "Change address"
    wait_for "Address in your network" 10 >/dev/null || fail "Change address did not open Settings"
    shot change-address
    adb_ shell input keyevent KEYCODE_BACK
    wait_for "Turn off" 10 >/dev/null || fail "the main screen did not come back"
    "$TESTPEER" machines | sed 's/^/[peer machines] /'
}

main() {
    rm -rf "$OUT"
    mkdir -p "$OUT"
    [ -f "$APK" ] && [ -f "$TEST_APK" ] || fail "no APKs. Run: make network-test"
    [ "$(adb_ shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] || fail "$SERIAL is not booted"

    trap finish EXIT
    ANDROID_SERIAL="$SERIAL" EDGEVPN_ADB="$ADB" "$ROOT/scripts/settle-emulator" ||
        fail "a system popup kept the focus on the emulator"
    if ! "$TESTPEER" status >/dev/null 2>&1; then
        STARTED_PEER=1
        "$TESTPEER" up
    fi
    local peer
    peer=$("$TESTPEER" addr)
    log "peer at $peer"
    wait_for_network
    [ "$SWITCH" = 0 ] || ensure_wifi

    # A device that ran tests before may still have the app, signed with
    # another machine's debug key; Android then refuses to install over it.
    adb_ uninstall "$PACKAGE.test" >/dev/null 2>&1 || true
    adb_ uninstall "$PACKAGE" >/dev/null 2>&1 || true
    adb_ install -r "$APK" >/dev/null
    adb_ install -r "$TEST_APK" >/dev/null
    adb_ shell am force-stop "$PACKAGE"
    adb_ shell pm clear "$PACKAGE" >/dev/null
    # A large buffer keeps the whole run in the log so the checks below see it.
    adb_ logcat -G 16M
    clear_log || fail "could not clear the emulator's log"

    # The files go straight from the key file into the app's private
    # storage, so the key never appears on a command line. They go through
    # adb shell's stdin: adb exec-in often ends the command before it has
    # read its input, on every API level tried, and on Android 8 it never
    # wrote the file in six tries.
    adb_ shell run-as "$PACKAGE" mkdir -p files/network-test
    adb_ shell "run-as $PACKAGE sh -c 'cat > files/network-test/token'" <"$("$TESTPEER" key)"
    echo "$peer" | adb_ shell "run-as $PACKAGE sh -c 'cat > files/network-test/peers'"
    local result
    result=$(adb_ shell am instrument -w -e class com.kairos.edgevpn.NetworkTestSetup "$RUNNER" | scrub) ||
        fail "could not run or scrub the setup step"
    if ! echo "$result" | grep -q "^OK (1 test)"; then
        # Only the lines that say what failed, never the whole output.
        echo "$result" | grep -E "^(FAILURES|There was|[0-9]+\)|Tests run|[a-zA-Z.]*(Error|Exception))" | head -n 20
        fail "storing the test network in the app"
    fi
    log "test network stored in the app"

    # Android asks once whether the app may run a VPN. The answer is set
    # here instead, as the dialog would.
    adb_ shell appops set "$PACKAGE" ACTIVATE_VPN allow

    if [ "$SCENARIO" = address-in-use ]; then
        address_in_use "$peer"
        return
    fi

    dismiss_dialogs
    adb_ shell am start -W -n "$PACKAGE/.MainActivity" >/dev/null
    wait_for "Turn on" 30 >/dev/null || fail "the main screen did not show Turn on"
    tap "Turn on"
    log "turned on"
    local took
    took=$(wait_for "Connected" "$CONNECT_TIMEOUT") || { shot not-connected; fail "not connected after ${CONNECT_TIMEOUT}s"; }
    log "connected after ${took}s"
    no_protect_failures
    shot connected

    check_vpn_routes

    ping_until app "$PEER_ADDRESS" 60 || fail "the app cannot ping the peer"
    ping_until peer "$APP_ADDRESS" 60 || fail "the peer cannot ping the app"
    local sockets
    sockets=$(listen_sockets) || fail "could not find the app's uid"
    log "app LISTEN sockets: $sockets"
    [ "$sockets" -gt 0 ] || fail "the app has no listening sockets"
    peer_has_app || fail "the peer does not list $APP_ADDRESS while connected"
    log "the peer lists $APP_ADDRESS"
    no_address_warning
    screens

    if [ "$SWITCH" != 0 ]; then
        local mdns_before mdns_off
        if ! has_airplane_cmd; then
            adb_as_root || fail "airplane mode needs adbd as root on $SERIAL, and adb root did not work"
            log "adbd runs as root for the AIRPLANE_MODE broadcast"
        fi
        mdns_off=$(mdns_lines)
        switch_step wifi-off 'adb_ shell svc wifi disable; wait_wlan0 down || fail "wlan0 did not go down"'
        if [ "$MDNS_CHECK" != 0 ]; then
            [ "$(mdns_lines)" -eq "$mdns_off" ] || fail "the app started mDNS on mobile data after Wi-Fi went off"
            log "the app kept mDNS off on mobile data"
        fi
        mdns_before=$(mdns_wlan0_lines)
        switch_step wifi-on 'adb_ shell svc wifi enable; wait_wlan0 up 120 || fail "wlan0 did not come up within 120s"; log "wlan0 is up after $(($(date +%s) - start))s"; start=$(date +%s)'
        if [ "$MDNS_CHECK" != 0 ]; then
            local waited=0
            until [ "$(mdns_wlan0_lines)" -gt "$mdns_before" ]; do
                [ "$waited" -lt "$SWITCH_TIMEOUT" ] || fail "no fresh mdns(android) line listing wlan0 within ${SWITCH_TIMEOUT}s of Wi-Fi coming back"
                sleep 2
                waited=$((waited + 2))
            done
            log "the app restarted mDNS on wlan0 after Wi-Fi came back"
        fi
        switch_step airplane 'airplane_mode enable
            [ "$(adb_ shell settings get global airplane_mode_on | tr -d "\r")" = 1 ] || fail "airplane mode did not turn on"
            wait_wlan0 down || fail "wlan0 did not go down in airplane mode"
            sleep 10
            start=$(date +%s)
            airplane_mode disable
            wait_wlan0 up 120 || fail "wlan0 did not come back within 120s of airplane mode off"
            log "wlan0 is up after $(($(date +%s) - start))s"
            start=$(date +%s)'
    fi

    if [ "$LONG" != 0 ]; then
        tap "Turn off"
        wait_for "VPN is off" 30 >/dev/null || fail "the VPN did not turn off"
        log "turned off, waiting ${OFF_SECONDS}s"
        sleep "$OFF_SECONDS"
        if peer_has_app; then
            fail "the peer still lists $APP_ADDRESS after ${OFF_SECONDS}s off"
        fi
        log "the peer has dropped $APP_ADDRESS from its machine list"
        tap "Turn on"
        log "turned on again"
        took=$(wait_for "Connected" "$RECOVER_TIMEOUT") || { shot not-reconnected; fail "not connected again after ${RECOVER_TIMEOUT}s"; }
        log "connected again after ${took}s"
        check_vpn_routes
        ping_until app "$PEER_ADDRESS" "$RECOVER_TIMEOUT" || fail "the app cannot ping the peer after off and on"
        ping_until peer "$APP_ADDRESS" "$RECOVER_TIMEOUT" || fail "the peer cannot ping the app after off and on"
        local after
        after=$(listen_sockets) || fail "could not find the app's uid"
        log "app LISTEN sockets after off and on: $after (before: $sockets)"
        [ "$after" -eq "$sockets" ] || fail "the app has $after listening sockets after off and on, want $sockets as before"
        no_address_warning
    fi

    no_protect_failures
    shot connected-final
    "$TESTPEER" machines | sed 's/^/[peer machines] /'
}

main "$@"
